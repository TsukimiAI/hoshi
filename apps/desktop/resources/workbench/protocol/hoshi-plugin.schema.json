{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["id", "name", "description", "version", "tool"],
  "additionalProperties": true,
  "properties": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
    "kind": { "enum": ["native", "mcp"] },
    "template": { "enum": ["panel", "launcher", "mcp", "theme"] },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "version": { "type": "string", "minLength": 1 },
    "tool": {
      "type": "object",
      "required": ["name", "parameters"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "parameters": { "type": "object" }
      }
    },
    "settingsFields": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "label"],
        "properties": {
          "key": { "type": "string" },
          "label": { "type": "string" },
          "type": { "enum": ["text", "password", "textarea"] },
          "placeholder": { "type": "string" }
        }
      }
    },
    "contributes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sprites": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "slots": {
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "multiple": { "type": "boolean" },
        "filters": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "extensions"],
            "properties": {
              "name": { "type": "string" },
              "extensions": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "required": ["menu"],
      "properties": {
        "menu": {
          "type": "object",
          "required": ["label"],
          "properties": {
            "label": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
